#!/usr/bin/env bash

BG="#050505"
SEL_BG="#111111"

FG="#808080"
SEL_FG="#FFFFFF"

DMENU="dmenu -i \
-fn 'Iosevka Nerd Font:size=11' \
-nb '$BG' \
-nf '$FG' \
-sb '$SEL_BG' \
-sf '$SEL_FG' \
-p 'Screenshot'"

choice=$(printf "screen\narea\nwindow" | eval "$DMENU")

case "$choice" in
  screen) maim | xclip -selection clipboard -t image/png ;;
  area) maim -s | xclip -selection clipboard -t image/png ;;
  window) maim -i "$(xdotool getactivewindow)" | xclip -selection clipboard -t image/png ;;
esac
